#version 450

layout( triangles ) in;
layout( triangle_strip, max_vertices=3 ) out;

out vec3 color_frag;

in vec3 color[3];


mat4 model_view_matrix = mat4(
			      0.57735, -0.33333, 0.57735, 0.00000,
			      0.00000, 0.66667, 0.57735, 0.00000,
			      -0.57735, -0.33333, 0.57735, 0.00000,
			      0.00000, 0.00000, -17, 1.00000);
mat4 projection_matrix = mat4(
			      15.00000, 0.00000, 0.00000, 0.00000,
			      0.00000, 15.00000, 0.00000, 0.00000,
			      0.00000, 0.00000, -1.00020, -1.00000,
			      0.00000, 0.00000, -10.00100, 0.00000);

void main() {
    color_frag = color[0];
    gl_Position = projection_matrix * model_view_matrix * gl_in[0].gl_Position;
    EmitVertex();
    color_frag = color[1];
    gl_Position = projection_matrix * model_view_matrix * gl_in[1].gl_Position;
    EmitVertex();
    color_frag = color[2];
    gl_Position = projection_matrix * model_view_matrix * gl_in[2].gl_Position;
    EmitVertex();
    EndPrimitive();
}