#version 450

layout( triangles ) in;
layout( line_strip, max_vertices=2 ) out;

out vec3 color_frag;

in vec3 color[3];
in vec3 normal[3];

vec3 light_color = vec3(1.0, 1.0, 1.0);
vec3 light_position = vec3(-10.0, -10.0, -50.0);

mat4 model_view_matrix = mat4(
			      0.57735, -0.33333, 0.57735, 0.00000,
			      0.00000, 0.66667, 0.57735, 0.00000,
			      -0.57735, -0.33333, 0.57735, 0.00000,
			      0.00000, 0.00000, -17, 1.00000);
mat4 projection_matrix = mat4(
			      15.00000, 0.00000, 0.00000, 0.00000,
			      0.00000, 15.00000, 0.00000, 0.00000,
			      0.00000, 0.00000, -1.00020, -1.00000,
			      0.00000, 0.00000, -10.00100, 0.00000);

void main() {
    vec4 position = (gl_in[0].gl_Position + gl_in[1].gl_Position + gl_in[2].gl_Position) / 3.0;
    vec3 centered_normal = (normal[0] + normal[1] + normal[2]) / 3.0;
    float c = clamp(dot(normalize(light_position - position.xyz), normalize(centered_normal)), 0.0, 1.0);

    color_frag = vec3(1.0 * c, (sin(c) + 1.0 / 2.0), c);
    gl_Position = projection_matrix * model_view_matrix * position;
    EmitVertex();

    color_frag = vec3(1.0 * c, (sin(c) + 1.0 / 2.0), c);
    gl_Position = projection_matrix * model_view_matrix * (position + 0.05 * (c + 1.0) * vec4(centered_normal, 1.0));
    EmitVertex();

    EndPrimitive();
}