#version 450

layout( vertices = 4 ) out;

in vec3 vs_color[];
in vec3 vs_normal[];
out vec3 tsc_color[];
out vec3 tsc_normals[];

uniform float nb_divisions;
uniform float middle_divisions1;
uniform float middle_divisions2;

void main() {
    gl_TessLevelOuter[0] = nb_divisions;
    gl_TessLevelOuter[1] = nb_divisions;
    gl_TessLevelOuter[2] = nb_divisions;
    gl_TessLevelOuter[3] = nb_divisions;

    gl_TessLevelInner[0] = middle_divisions1;
    gl_TessLevelInner[1] = middle_divisions2;

    gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;
    tsc_color[gl_InvocationID] = vs_color[gl_InvocationID];
    tsc_normals[gl_InvocationID] = vs_normal[gl_InvocationID];
}
