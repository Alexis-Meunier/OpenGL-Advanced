#version 450

layout( vertices = 4 ) out;

in vec3 vs_color[];
in vec3 vs_normal[];
out vec3 tsc_color[];
out vec3 tsc_normals[];

uniform int nb_divisions;

void main() {
    gl_TessLevelOuter[0] = 15;
    gl_TessLevelOuter[1] = 25;
    gl_TessLevelOuter[2] = 35;
    gl_TessLevelOuter[3] = 20;

    gl_TessLevelInner[0] = 5;
    gl_TessLevelInner[1] = 10;

    gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;
    tsc_color[gl_InvocationID] = vs_color[gl_InvocationID];
    tsc_normals[gl_InvocationID] = vs_normal[gl_InvocationID];
}
