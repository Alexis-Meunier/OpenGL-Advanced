#version 450

layout(triangles) in;
layout(points, max_vertices = 10) out;

layout(location=0) out vec3 g_color;
layout(location=1) out vec3 g_normal;
layout(location=2) out vec3 g_pos;

layout(location=0) in vec3 vs_color[3];
layout(location=1) in vec3 vs_normal[3];

uniform mat4  model;
uniform mat4  view;
uniform mat4  proj;
uniform float anim_time;
uniform float t_explode;

const int  N_PARTICLES = 0;
const vec3 GRAV = vec3(0.0, -1.0, 0.0);

float hash(float n) { return fract(sin(n * 12.9898) * 43758.5453); }

void emit_point(vec3 p, vec3 color, vec3 normal, float size) {
    vec4 world = model * vec4(p, 1.0);
    gl_Position = proj * view * world;
    gl_PointSize = size;
    g_color = color;
    g_normal = normal;
    g_pos = world.xyz;
    EmitVertex();
    EndPrimitive();
}

void main() {
    float t = max(anim_time - t_explode, 0.0);

    vec3 a = gl_in[0].gl_Position.xyz;
    vec3 b = gl_in[1].gl_Position.xyz;
    vec3 c = gl_in[2].gl_Position.xyz;

    for (int i = 0; i < 3; i++)
        emit_point(gl_in[i].gl_Position.xyz,
                   vs_color[i] + vec3(0.8, 0.0, 0.0),
                   vs_normal[i], 7.0);

    vec3 inter_col = (vs_color[0] + vs_color[1] + vs_color[2]) / 3.0;

    vec3 n = normalize(vs_normal[0] + vs_normal[1] + vs_normal[2]);
    for (int k = 0; k < N_PARTICLES; k++) {
        float seed = float(gl_PrimitiveIDIn) * 7.0 + float(k);

        float u = hash(seed), v = hash(seed + 1.3);
        if (u + v > 1.0) { u = 1.0 - u; v = 1.0 - v; }
        vec3 p = a + u * (b - a) + v * (c - a);

        vec3 rnd = vec3(hash(seed + 2.0), hash(seed + 3.0), hash(seed + 4.0)) - 0.5;
        vec3 vel = (0.5 * n + rnd) * 0.8;
        p += vel * t + 0.5 * GRAV * t * t;

        emit_point(p, inter_col + vec3(0.8, 0.0, 0.0), n, 7.0);
    }
}