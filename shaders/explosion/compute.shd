#version 450
#define M_PI 3.14159265358979

layout(local_size_x = 256) in;

float levels = 5.0;

uniform float anim_time;
uniform int nb_vertex;
uniform float dt;          // time since the previous dispatch
uniform mat4 model;
uniform float water_y;     // world height of the water plane
uniform float plane_size;  // water plane is centred on the origin in xz

layout(binding = 3, r32i) uniform coherent iimage2D splash_img;

layout(std430, binding = 1) buffer point_pos_buffer { float positions[]; };
layout(std430, binding = 2) buffer normal_pos_buffer { float norm[]; };
layout(std430, binding = 3) buffer org_pos_buffer { float orig[]; };

const vec3 grav = normalize(vec3(0.0, -9.81, 0.0));

void main(void) {
    uint i = gl_GlobalInvocationID.x;
    if (i >= nb_vertex) return;

    float D0 = 3.0; // duration of the first pump (seconds)
    float dTime = 0.8; // each pump lasts r times the previous one
    float A0 = 0.03; // amplitude of the first pump
    float max_pumps = 10.0; // pumps before the explosion

    float x = 1.0 - anim_time * (1.0 - dTime) / D0; // The faster each pump last, the faster the explosion comes --> 1.0 - dTime
    float n = (x > 0.0) ? floor(log(x) / log(dTime)) : max_pumps; // Exponential explosion --> Derive

    float amount = 0.0;
    float start = D0 * (1.0 - pow(dTime, n)) / (1.0 - dTime); // Geometric Sum of D0 + D0 * dTime + D0 * dTime^2 ...
    float dur = D0 * pow(dTime, n); // Each pump is 0.8 times slower, so the nth pump is 0.8^n times slower than D0
    if (n < max_pumps || (n == max_pumps - 1 && anim_time - start == dur)) {
        float s = clamp((anim_time - start) / dur, 0.0, 1.0); // Where we are during the pump
        amount = sin(s * M_PI) * A0 * (1.0 + n);

        for (uint c = 0; c < 3; c++) {
            uint k = 3 * i + c;
            positions[k] = orig[k] + norm[k] * amount;
        }
    }
    else {
        float tExplode = D0 * (1.0 - pow(dTime, max_pumps)) / (1.0 - dTime);
        float t = anim_time - tExplode;

        uint triangle_nbr = i / 3;
        uint triangle_idx = 9 * triangle_nbr;

        vec3 vertex_0 = vec3(orig[triangle_idx], orig[triangle_idx + 1], orig[triangle_idx + 2]);
        vec3 vertex_1 = vec3(orig[triangle_idx + 3], orig[triangle_idx + 4], orig[triangle_idx + 5]);
        vec3 vertex_2 = vec3(orig[triangle_idx + 6], orig[triangle_idx + 7], orig[triangle_idx + 8]);
        vec3 center = (vertex_0 + vertex_1 + vertex_2) / 3.0;

        vec3 normal_0 = vec3(norm[triangle_idx], norm[triangle_idx + 1], norm[triangle_idx + 2]);
        vec3 normal_1 = vec3(norm[triangle_idx + 3], norm[triangle_idx + 4], norm[triangle_idx + 5]);
        vec3 normal_2 = vec3(norm[triangle_idx + 6], norm[triangle_idx + 7], norm[triangle_idx + 8]);
        vec3 norm_center = (normal_0 + normal_1 + normal_2) / 3.0;
        vec3 v0 = 1.5 * normalize(norm_center);

        uint k = 3 * i;
        vec3 p0 = vec3(orig[k], orig[k + 1], orig[k + 2]);
        vec3 p = p0 + v0 * t + 0.5 * grav * t * t;

        positions[k] = p.x;
        positions[k + 1] = p.y;
        positions[k + 2] = p.z;

        float tp = t - dt;
        if (tp >= 0.0) {
            vec3 prev = p0 + v0 * tp + 0.5 * grav * tp * tp;
            vec4 w = model * vec4(p, 1.0);
            if ((model * vec4(prev, 1.0)).y > water_y && w.y <= water_y) {
                vec2 uv = w.xz / plane_size + 0.5;
                if (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0))))
                    imageAtomicAdd(splash_img, ivec2(uv * vec2(imageSize(splash_img))), 1);
            }
        }
    }
}