#version 450

layout(location=0) in vec3 tile_cell;

out vec3 vs_pos;
out vec3 vs_rnd;

uniform vec3 cameraPos;

uniform int grass_grid;
uniform float grass_tile;
uniform float grass_cells;

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec2 hash22(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.xx + p3.yz) * p3.zy);
}

void main() {
    ivec2 t = ivec2(gl_InstanceID % grass_grid, gl_InstanceID / grass_grid) - grass_grid / 2;
    vec2 tile_idx = floor(cameraPos.xz / grass_tile) + vec2(t);

    vec2 cell = floor(tile_cell.xz * grass_cells + 0.5);
    vec2 id = tile_idx * grass_cells + cell;

    vec2 xz = (id + hash22(id)) * (grass_tile / grass_cells);

    vs_pos = vec3(xz.x, 0.0, xz.y);
    vs_rnd = vec3(hash12(id + 17.0), hash12(id + 31.0), hash12(id + 47.0));
}
