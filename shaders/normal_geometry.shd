#version 450

layout( triangles ) in;
layout( line_strip, max_vertices=10 ) out;

out vec3 color_frag;

in vec3 color[3];
in vec3 normal[3];

// vec3 light_color = vec3(1.0, 1.0, 1.0);
// vec3 light_pos = vec3(-10.0, -10.0, -50.0);

uniform vec3 light_color;
uniform vec3 light_pos;
uniform float normal_length;
// float normal_length = 0.05;

uniform mat4 camera;
uniform mat4 projection;
// mat4 camera = mat4(
// 			      0.57735, -0.33333, 0.57735, 0.00000,
// 			      0.00000, 0.66667, 0.57735, 0.00000,
// 			      -0.57735, -0.33333, 0.57735, 0.00000,
// 			      0.00000, 0.00000, -17, 1.00000);
// mat4 projection = mat4(
// 			      15.00000, 0.00000, 0.00000, 0.00000,
// 			      0.00000, 15.00000, 0.00000, 0.00000,
// 			      0.00000, 0.00000, -1.00020, -1.00000,
// 			      0.00000, 0.00000, -10.00100, 0.00000);

vec4 grav = vec4(0.0, -9.81, 0.0, 1.0);

void main() {
    vec4 position = (gl_in[0].gl_Position + gl_in[1].gl_Position + gl_in[2].gl_Position) / 3.0;
    vec3 centered_normal = (normal[0] + normal[1] + normal[2]) / 3.0;
    float c = clamp(dot(normalize(light_pos - position.xyz), normalize(centered_normal)), 0.0, 1.0);
    vec3 out_color = vec3(1.0 * c, (sin(c) + 1.0 / 2.0), c);

    for (float i = 0.0; i < 10.0; i++)
    {
        color_frag = out_color;
        float t = normal_length * i;
        vec4 p = position + t * vec4(centered_normal, 1.0) + (1.0 / 2.0 * normalize(grav) * t * t );
        gl_Position = projection * camera * vec4(p.xyz, 1.0);
        EmitVertex();
    }

    EndPrimitive();
}