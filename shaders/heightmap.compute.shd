#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 1, r32f) uniform writeonly image2D heightmap_out;

const int OCTAVES = 6;
const float BASE_FREQ = 3.0;
const float LACUNARITY = 2.0;
const float GAIN = 0.5;

float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);

    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(vec2 st) {
    const mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.5));
    float value = 0.0;
    float amp = 0.5;
    float norm = 0.0;
    for (int i = 0; i < OCTAVES; i++) {
        value += amp * noise(st);
        norm  += amp;
        st = rot * st * LACUNARITY + vec2(100.0);
        amp *= GAIN;
    }
    return value / norm;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(heightmap_out);
    if (px.x >= size.x || px.y >= size.y) return;

    vec2 uv = (vec2(px) + 0.5) / vec2(size);
    float h = fbm(uv * BASE_FREQ);

    h = pow(h, 1.6);
    imageStore(heightmap_out, px, vec4(h, 0.0, 0.0, 0.0));
}
