#version 450

// Full-screen triangle, no vertex buffer needed: draw with glDrawArrays(GL_TRIANGLES, 0, 3).
// Vertices: (-1,-1), (3,-1), (-1,3). The part that falls outside the screen is clipped.
out vec2 uv;

void main()
{
    vec2 p = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2); // (0,0) (2,0) (0,2)
    uv = p;
    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);
}
