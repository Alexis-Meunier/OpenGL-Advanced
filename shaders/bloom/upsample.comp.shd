#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D src;
layout(binding = 0, r11f_g11f_b10f) uniform image2D dst;

uniform float radius;

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dst_size = imageSize(dst);
    if (any(greaterThanEqual(px, dst_size)))
        return;

    vec2 uv = (vec2(px) + 0.5) / vec2(dst_size);
    vec2 o  = radius / vec2(textureSize(src, 0));

    vec3 a = texture(src, uv + vec2(-o.x,  o.y)).rgb;
    vec3 b = texture(src, uv + vec2( 0.0,  o.y)).rgb;
    vec3 c = texture(src, uv + vec2( o.x,  o.y)).rgb;
    vec3 d = texture(src, uv + vec2(-o.x,  0.0)).rgb;
    vec3 e = texture(src, uv).rgb;
    vec3 f = texture(src, uv + vec2( o.x,  0.0)).rgb;
    vec3 g = texture(src, uv + vec2(-o.x, -o.y)).rgb;
    vec3 h = texture(src, uv + vec2( 0.0, -o.y)).rgb;
    vec3 i = texture(src, uv + vec2( o.x, -o.y)).rgb;

    vec3 up = (e * 4.0 + (b + d + f + h) * 2.0 + (a + c + g + i)) / 16.0;

    vec3 existing = imageLoad(dst, px).rgb;
    imageStore(dst, px, vec4(existing + up, 1.0));
}
