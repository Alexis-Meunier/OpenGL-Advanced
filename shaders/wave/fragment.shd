#version 450
#define M_PI 3.14159265358979

#define MAX_LIGHTS 16

in vec3 fr_color;
in vec3 fr_pos;
in vec2 fr_uv;

layout(location=0) out vec4 out_color;

struct Light {
    vec3 pos;
    vec3 dir;
    vec3 color;
    float intensity;
    int type;          // 0 = point, 1 = directional
};
uniform Light lights[MAX_LIGHTS];
uniform int nb_lights;

uniform sampler2D wave_tex;

// Point lights only reach a limited distance, so each one stays local and
// the colours of different lights don't pile up everywhere. The sun has no falloff.
#define LIGHT_RANGE 12.0
float attenuation(Light l, vec3 p)
{
    if (l.type == 1)
        return 1.0;
    float d = length(l.pos - p);
    float window = clamp(1.0 - pow(d / LIGHT_RANGE, 4.0), 0.0, 1.0);
    return window * window / (1.0 + 0.5 * d * d);
}


uniform vec3 cameraPos;

vec3 V = vec3(0.0);

float cdot(vec3 v, vec3 w) { return clamp(dot(v, w), 0.0, 1.0); }

vec3 fresnel(vec3 f0, float cos_theta) {
  return f0 + (1.0 - f0) * pow(1.0 - cos_theta, 5.0);
}

float normal_dist(float NdotH, float rough) {
  float a  = rough * rough;
  float a2 = a * a;
  float d  = NdotH * NdotH * (a2 - 1.0) + 1.0;
  return a2 / (M_PI * d * d);
}

float gschlick(float NdotW, float rough) {
  float k = pow(rough + 1.0, 2.0) / 8.0;
  return NdotW / (NdotW * (1.0 - k) + k);
}

vec3 fresnel(vec3 f0, vec3 w0) {
  return f0 + (1.0 - f0) * pow(1.0 - cdot(V, w0), 5.0);
}

void main() {
    float roughness = 0.5;

    vec4 w = texture(wave_tex, fr_uv);
    vec3 N = normalize(vec3(-w.g, 1.0, -w.b));
    // N = normalize(mix(N, vec3(0, 1, 0), clamp(dist * 0.01, 0, 1)))

    vec3 V = normalize(cameraPos - fr_pos);
    float NdotV = max(cdot(N, V), 1e-4);

    vec3 sun_col = lights[0].color * lights[0].intensity;
    // 0 at night, 1 in daylight (same curve as the skybox)
    float day = smoothstep(-0.10, 0.25, lights[0].dir.y);
    vec3 color = 0.15 * fr_color * (mix(0.05, 0.4, day) + 0.6 * sun_col);
    for (int i = 0; i < nb_lights; i++)
    {
        vec3 L = (lights[i].type == 1)
               ? normalize(lights[i].dir)
               : normalize(lights[i].pos - fr_pos);
        vec3 H = normalize(L + V);

        float NdotL = cdot(N, L);
        float NdotH = cdot(N, H);

        vec3 F = fresnel(vec3(0.04), cdot(H, V));
        float D = normal_dist(NdotH, roughness);
        float G = gschlick(NdotL, roughness) * gschlick(NdotV, roughness);

        vec3 specular = F * D * G / max(4.0 * NdotV * NdotL, 1e-4);
        vec3 diffuse  = (1.0 - F) * fr_color;

        color += (diffuse + specular) * lights[i].color * lights[i].intensity * attenuation(lights[i], fr_pos) * NdotL;
    }

    // What the water reflects: the daytime sky, fading to the dark night sky.
    vec3 day_sky   = mix(vec3(0.5, 0.7, 1.0), sun_col, 0.6);
    vec3 night_sky = vec3(0.04, 0.05, 0.10);
    vec3 sky = mix(night_sky, day_sky, day);
    float fr = pow(1.0 - NdotV, 5.0);
    color = mix(color, sky, 0.04 + 0.9 * fr);
    out_color = vec4(color, 1.0);
}
